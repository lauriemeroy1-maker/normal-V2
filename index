<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Normade Studio — Content design · 콘텐츠 디자인 · Seoul ↔ Paris</title>
<script>document.documentElement.classList.add('js')</script>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{
  --paper:#F9F9F6; --ink:#000; --mute:#77776f; --bar:76px; --sw:48px;
  --body:"Pretendard Variable",Pretendard,system-ui,-apple-system,"Segoe UI",sans-serif;
  --display:var(--body); --hand:var(--body);
  --holes:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='48' height='48'><rect x='14' y='14' width='20' height='20' rx='5' fill='%23F9F9F6'/></svg>");
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:var(--bar)}
body{font-family:var(--body);background:var(--paper);color:var(--ink);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.ko{word-break:keep-all}

/* ---------- Barre du haut ---------- */
.top{position:fixed;inset:0 0 auto 0;z-index:2000;height:calc(var(--bar) + env(safe-area-inset-top,0px));display:flex;align-items:center;justify-content:space-between;
  padding:env(safe-area-inset-top,0px) clamp(16px,4vw,48px) 0;background:var(--paper);border-bottom:1px solid rgba(0,0,0,.08)}
.logo{font-family:var(--display);font-weight:700;font-size:22px;text-decoration:none;letter-spacing:-.02em}
.pill{display:flex;gap:4px;padding:5px;border-radius:99px;border:1.5px solid rgba(0,0,0,.15)}
.pill a{padding:8px 18px;border-radius:99px;text-decoration:none;font-size:15px;font-weight:500;transition:background .2s,color .2s;white-space:nowrap}
.pill a:hover,.pill a.on{background:var(--ink);color:var(--paper)}
.pill .ko,.cta .ko{font-size:.86em;opacity:.65;margin-left:4px}
.cta{background:var(--ink);color:var(--paper);padding:12px 22px;border-radius:99px;font-weight:600;font-size:15px;text-decoration:none;white-space:nowrap}
@media(max-width:760px){.pill{display:none}}

/* ---------- Page = pellicule ---------- */
.cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:clamp(24px,5vw,96px);padding:0 0 0 clamp(16px,4vw,48px)}
.side{position:sticky;top:var(--bar);align-self:start;padding-top:48px}
.js .side{opacity:0}.loaded .side{opacity:1;transition:opacity .7s .9s}

.side h1{font-family:var(--display);font-weight:700;font-size:clamp(32px,3.3vw,54px);line-height:.98;letter-spacing:-.035em}
.side h1 .ko{display:block;margin-top:14px;font-size:.42em;font-weight:700;letter-spacing:-.01em;line-height:1.35;color:var(--mute)}
.side .sub{margin-top:26px;max-width:34ch;font-size:16px;line-height:1.5;color:var(--mute)}
.side .sub .ko{display:block;margin-top:6px;font-size:15px}
.hand{font-size:17px;font-weight:500;line-height:1.3;color:var(--mute);margin:22px 0 18px}
.hand .ko{display:block}
.ghost{background:none;border:1.5px solid rgba(0,0,0,.4);color:var(--ink);padding:11px 20px;border-radius:99px;font:600 14px var(--body);cursor:pointer;text-align:left}
.ghost:hover{background:var(--ink);color:var(--paper)}
.ghost .ko{margin-left:6px;opacity:.65;font-size:.9em}

.services{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px;margin-top:28px;max-width:44ch}
.services li{padding:7px 14px;border:1.5px solid rgba(0,0,0,.18);border-radius:99px;font-size:14px;font-weight:600}
.services .ko{margin-left:6px;font-weight:500;color:var(--mute);font-size:.92em}

.strip{position:relative;background:#000;padding:calc(var(--bar) + 24px) var(--sw) 56px;display:grid;gap:28px}
.js .strip{transform:translateY(-100vh)}
.loaded .strip{transform:none;transition:transform 1.15s cubic-bezier(.22,.9,.25,1)}
.strip::before,.strip::after{content:"";position:absolute;top:0;bottom:0;width:var(--sw);background:var(--holes) repeat-y 0 0/var(--sw) var(--sw)}
.strip::before{left:0}.strip::after{right:0}

.proj{position:relative;aspect-ratio:4/5;border-radius:3px;background:var(--bg);display:flex;align-items:flex-end;color:var(--paper)}
.proj .info{padding:22px;width:100%;background:linear-gradient(transparent,rgba(0,0,0,.74))}
.proj h3{font-family:var(--display);font-size:clamp(26px,2.6vw,36px);letter-spacing:-.02em;line-height:1}
.proj .meta{margin:10px 0 16px;font-size:15px;line-height:1.4;opacity:.92}
.proj .meta .ko{display:block;font-size:14px;opacity:.8}
.proj .see{display:inline-block;background:var(--paper);color:var(--ink);padding:9px 18px;border-radius:99px;font-size:14px;font-weight:600;text-decoration:none}
.proj .see .ko{margin-left:6px;opacity:.65;font-size:.92em}
.proj .tag{position:absolute;top:14px;right:14px;font-size:14px;font-weight:600;color:#fff;text-align:right;line-height:1.25;background:rgba(0,0,0,.38);padding:6px 10px;border-radius:8px}
.proj .tag .ko{display:block;font-weight:500;opacity:.85}

/* papier à déchirer : bord irrégulier en clip-path */
.scrap{position:absolute;inset:0;z-index:3;cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none;
  transform-origin:50% 0;transition:transform .35s cubic-bezier(.3,1.5,.5,1)}
.scrap.drag{cursor:grabbing;transition:none}
.scrap.gone{transition:transform .6s cubic-bezier(.5,0,1,.6),opacity .6s;pointer-events:none}
.scrap.wiggle{animation:wig .5s}
@keyframes wig{25%{transform:rotate(-3deg)}60%{transform:rotate(2.5deg)}}
.sheet{position:absolute;inset:0;display:grid;place-content:center;gap:6px;text-align:center;padding:24px 24px 40px;color:#1d1d1b;background:rgba(251,250,246,.55);
-webkit-backdrop-filter:blur(10px);
backdrop-filter:blur(10px);
  clip-path:polygon(0 0,100% 0,100% 88%,97% 91%,94% 87%,90% 93%,85% 89%,82% 94%,76% 90%,71% 96%,66% 91%,60% 95%,55% 90%,49% 94%,44% 89%,38% 95%,32% 91%,27% 96%,21% 91%,16% 95%,11% 90%,6% 94%,2% 90%,0 93%)}
.sheet b{font-family:var(--display);font-size:clamp(26px,2.8vw,38px);letter-spacing:-.02em;line-height:1}
.sheet .ko{font-size:15px;font-weight:500;color:#55554f}
.sheet span.h{font-size:15px;font-weight:500;line-height:1.35;color:#77776f;margin-top:12px}

/* ---------- Contact ---------- */
.contact{padding:clamp(72px,10vw,140px) clamp(16px,4vw,48px);text-align:center}
.contact h2{font-family:var(--display);font-size:clamp(40px,8vw,120px);line-height:.95;letter-spacing:-.04em}
.contact h2 .ko{display:block;margin-top:14px;font-size:.3em;font-weight:700;letter-spacing:0;color:var(--mute)}
.contact a.mail{display:inline-block;margin-top:36px;font-size:clamp(18px,2.4vw,30px);font-weight:600;text-underline-offset:6px}
footer{padding:0 clamp(16px,4vw,48px) 40px;color:var(--mute);font-size:14px;text-align:center}

@media(max-width:1100px){
  :root{--sw:36px}
  .cols{grid-template-columns:minmax(0,1fr);padding:0}
  .side{position:static;padding:calc(var(--bar) + 36px) 20px 32px}
  .side.right{display:none}
  .strip{padding-top:24px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.js .strip{transform:none}.loaded .strip,.scrap{transition:none}}
</style>
</head>
