<script>
/* La pellicule descend au chargement */
requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.add('loaded')));

/* Lien actif dans la barre */
const links = [...document.querySelectorAll('.pill a')];
const io = new IntersectionObserver(es => es.forEach(en => {
  if (en.isIntersecting) links.forEach(l => l.classList.toggle('on', l.getAttribute('href') === '#' + en.target.id));
}), { rootMargin: '-45% 0px -45% 0px' });
['work', 'contact'].forEach(id => io.observe(document.getElementById(id)));

/* Papiers déchirables */
(() => {
  const scraps = [...document.querySelectorAll('.scrap')], THRESHOLD = 90;
  const tear = (s, dx = 0, dy = 600, rot = 0) => {
    s.classList.remove('drag'); s.classList.add('gone');
    s.style.transform = `translate(${dx * 3}px,${dy}px) rotate(${rot || (dx >= 0 ? 18 : -18)}deg)`;
    s.style.opacity = 0;
    if (navigator.vibrate) navigator.vibrate(15);
  };
  scraps.forEach(s => {
    let sx, sy, dx, dy, moved;
    s.addEventListener('pointerdown', e => { s.setPointerCapture(e.pointerId); s.classList.add('drag'); sx = e.clientX; sy = e.clientY; dx = dy = 0; moved = false; });
    s.addEventListener('pointermove', e => {
      if (!s.classList.contains('drag')) return;
      dx = e.clientX - sx; dy = e.clientY - sy; moved = true;
      s.style.transform = `translate(${dx}px,${dy}px) rotate(${dx / 12}deg)`;
    });
    const end = () => {
      if (!s.classList.contains('drag')) return;
      s.classList.remove('drag');
      if (Math.hypot(dx, dy) > THRESHOLD) tear(s, dx, Math.max(dy, 200) * 1.5);
      else { s.style.transform = ''; if (!moved) { s.classList.add('wiggle'); setTimeout(() => s.classList.remove('wiggle'), 500); } }
    };
    s.addEventListener('pointerup', end); s.addEventListener('pointercancel', end);
    s.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tear(s, 20, 700, 14); } });
  });
  document.getElementById('reset').addEventListener('click', () => scraps.forEach(s => { s.classList.remove('gone'); s.style.transform = ''; s.style.opacity = ''; }));
})();
</script>
